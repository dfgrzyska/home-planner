{
  "_comment": "Qwen-Image-Edit (GGUF Q5) – model już zainstalowany lokalnie. Przepis jak w oficjalnym szablonie ComfyUI: AuraFlow shift 3, CFGNorm, 20 kroków, cfg 2.5.",
  "1": { "class_type": "UnetLoaderGGUF", "inputs": { "unet_name": "Qwen_Image_Edit-Q5_K_M.gguf" } },
  "2": { "class_type": "ModelSamplingAuraFlow", "inputs": { "model": ["1", 0], "shift": 3.0 } },
  "3": { "class_type": "CFGNorm", "inputs": { "model": ["2", 0], "strength": 1.0 } },
  "4": { "class_type": "CLIPLoader", "inputs": { "clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors", "type": "qwen_image", "device": "default" } },
  "5": { "class_type": "VAELoader", "inputs": { "vae_name": "Qwen_Image-VAE.safetensors" } },
  "6": { "class_type": "LoadImage", "inputs": { "image": "{{IMAGE}}" } },
  "7": { "class_type": "ImageScaleToTotalPixels", "inputs": { "image": ["6", 0], "upscale_method": "lanczos", "megapixels": 1.0 } },
  "8": { "class_type": "TextEncodeQwenImageEdit", "inputs": { "clip": ["4", 0], "prompt": "{{PROMPT}}", "vae": ["5", 0], "image": ["7", 0] } },
  "9": { "class_type": "TextEncodeQwenImageEdit", "inputs": { "clip": ["4", 0], "prompt": "{{NEGATIVE}}", "vae": ["5", 0], "image": ["7", 0] } },
  "10": { "class_type": "VAEEncode", "inputs": { "pixels": ["7", 0], "vae": ["5", 0] } },
  "11": { "class_type": "KSampler", "inputs": { "model": ["3", 0], "positive": ["8", 0], "negative": ["9", 0], "latent_image": ["10", 0], "seed": "{{SEED}}", "steps": 20, "cfg": 2.5, "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0 } },
  "12": { "class_type": "VAEDecode", "inputs": { "samples": ["11", 0], "vae": ["5", 0] } },
  "13": { "class_type": "SaveImage", "inputs": { "images": ["12", 0], "filename_prefix": "home-planner/render" } }
}
